# Canonical local configuration template. Copy only this file to .env.local.
# Do not create .env.local.cmd; the Node Agent CLI reads .env.local only.
OPENAI_API_KEY=
OKCANVAS_AGENT_MODEL=
# Product-default Session Agent. Override only when another Agent is intentional.
OKCANVAS_DEFAULT_AGENT_ID=conversational-coding-agent
OKCANVAS_CODEX_MODEL=
# Optional absolute Codex CLI path:
# CODEX_PATH=C:\Users\User\AppData\Roaming\npm\codex.cmd

# STEP008 local-admin-only Control API
OKCANVAS_CONTROL_ADMIN_KEY=replace-with-at-least-16-random-characters
OKCANVAS_PROJECT_ROOT=.
OKCANVAS_PRODUCT_DB=.local\product.sqlite3
OKCANVAS_ARTIFACT_ROOT=.local\artifacts
OKCANVAS_EVALUATION_DB=.local\evaluation.sqlite3

# STEP091D optional S3 / S3-compatible Artifact Object Storage deployment.
# Local filesystem remains the default unless the backend is explicitly selected.
# OKCANVAS_ARTIFACT_BLOB_STORE_BACKEND=object-storage-artifact-v1
# OKCANVAS_ARTIFACT_OBJECT_BUCKET=existing-artifact-bucket
# OKCANVAS_ARTIFACT_OBJECT_PREFIX=okcanvas-artifacts
# OKCANVAS_ARTIFACT_OBJECT_ENDPOINT_URL=http://127.0.0.1:9000
# OKCANVAS_ARTIFACT_OBJECT_REGION=us-east-1
# OKCANVAS_ARTIFACT_OBJECT_ADDRESSING_STYLE=path
# Credentials remain in the standard boto3/AWS credential chain (for example local AWS_* env
# variables, profile, instance/task role). Never commit credential values to this file.
OKCANVAS_API_HOST=127.0.0.1
OKCANVAS_API_PORT=8765
OKCANVAS_CONTROL_BASE_URL=http://127.0.0.1:8765
# Project inspected by project-readonly-coding-agent. Change and restart the API for another project.
OKCANVAS_READONLY_WORKSPACE_ROOT=.
# Optional acceptance-only workspace root (defaults to the OS temporary directory)
# OKCANVAS_ACCEPTANCE_WORK_ROOT=D:\NODE_AGENTS\acceptance-work


# Direct legacy Run API is disabled unless explicitly set to true.
OKCANVAS_DIRECT_RUN_API_ENABLED=false

# STEP018 governed Run submission (separate from the read-only admin key)
OKCANVAS_RUN_SUBMITTER_KEY=replace-with-a-distinct-at-least-16-character-key
OKCANVAS_PROTECTED_PAYLOAD_ROOT=.local\protected-payloads
OKCANVAS_RUN_STATE_ROOT=.local\run-states
OKCANVAS_SESSION_ROOT=.local\sessions
# Required before creating or resuming SQLite Sessions. Keep distinct from the protected-payload key.
# .venv\Scripts\python.exe -c "from okcanvas_agent_runtime.sessions import generate_session_history_key; print(generate_session_history_key())"
OKCANVAS_SESSION_HISTORY_KEY=replace-with-a-distinct-generated-32-byte-urlsafe-base64-key
# Configure only while explicitly rotating existing Session history.
# OKCANVAS_SESSION_HISTORY_PREVIOUS_KEY=replace-with-the-previous-session-history-key
# Generate a 32-byte URL-safe key; never commit or reuse the admin/API/session-history key.
# .venv\Scripts\python.exe -c "from okcanvas_agent_runtime.protected_payload import generate_protected_payload_key; print(generate_protected_payload_key())"
OKCANVAS_PROTECTED_PAYLOAD_KEY=replace-with-generated-32-byte-urlsafe-base64-key

# STEP025 controlled read-only commerce snapshot source
# OKCANVAS_COMMERCE_SNAPSHOT_BASE_URL=http://127.0.0.1:9325
# OKCANVAS_COMMERCE_SNAPSHOT_BEARER_TOKEN=replace-with-source-only-token

rem STEP064 Session compaction uses the same official OpenAI API key only after the
rem encrypted Session reaches the fixed candidate trigger. No separate compaction key.
rem Deterministic acceptance does not issue a live responses.compact request.

# STEP074 live acceptance. The image must already exist locally; the Runtime never pulls it.
# The tag is resolved to a local immutable RepoDigest before container creation.
# OKCANVAS_SANDBOX_LIVE_IMAGE=hello-world:latest

# STEP075 Product-owned read-only Sandbox workspace (image must already be local).
OKCANVAS_SANDBOX_READONLY_IMAGE=busybox:1.36
OKCANVAS_SANDBOX_TEMP_ROOT=.local/sandbox-temp
