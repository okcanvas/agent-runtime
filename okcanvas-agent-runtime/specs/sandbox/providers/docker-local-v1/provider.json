{
  "schema_version": "okcanvas-sandbox-provider-contract-v1",
  "provider_id": "docker-local-v1",
  "version": "1.3.0",
  "provider_kind": "local-docker",
  "implementation_mode": "product-owned-readonly-workspace-agent-v1",
  "execution_enabled": true,
  "container_lifecycle_enabled": true,
  "sdk_client_mode": "not-used-product-owned-docker-cli",
  "image_reference_mode": "local-tag-resolved-to-immutable-repodigest",
  "runtime_image_pull_enabled": false,
  "command_mode": "product-owned-readonly-tool-command-only",
  "container_environment_enabled": false,
  "network_mode": "none",
  "exposed_ports": [],
  "host_bind_mounts_enabled": false,
  "remote_mounts_enabled": false,
  "docker_socket_mount_enabled": false,
  "privileged": false,
  "cap_add": [],
  "required_cap_drop": [
    "ALL"
  ],
  "no_new_privileges_required": true,
  "read_only_root_filesystem_required": true,
  "non_root_user_required": true,
  "non_root_user": "65532:65532",
  "memory_limit_bytes": 134217728,
  "nano_cpus": 500000000,
  "pids_limit": 64,
  "command_timeout_seconds": 30,
  "stop_timeout_seconds": 5,
  "max_captured_output_bytes": 131072,
  "required_labels": [
    "com.okcanvas.agent-runtime.sandbox",
    "com.okcanvas.agent-runtime.provider",
    "com.okcanvas.agent-runtime.step",
    "com.okcanvas.agent-runtime.acceptance-id"
  ],
  "resume_enabled": false,
  "snapshot_enabled": false,
  "automatic_delete_required": true,
  "orphan_reconciliation_required": true,
  "shell_enabled": false,
  "apply_patch_enabled": false,
  "skill_materialization_enabled": false,
  "workspace_materialization_mode": "docker-exec-stdin-tar-to-root-owned-tmpfs",
  "workspace_mount_path": "/workspace",
  "workspace_tmpfs_max_bytes": 33554432,
  "workspace_max_files": 3000,
  "workspace_max_total_bytes": 33554432,
  "workspace_max_file_bytes": 524288,
  "workspace_allowed_commands": [
    "find",
    "cat",
    "grep",
    "tail"
  ],
  "workspace_archive_format": "gnu-tar-v1",
  "workspace_materializer_user": "0:0",
  "workspace_materializer_command": [
    "tar",
    "-x",
    "-f",
    "-",
    "-C",
    "/workspace"
  ]
}
